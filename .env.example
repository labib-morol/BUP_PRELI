# Copy to .env and fill in. Never commit .env or real key values.
# At least one provider key is required for operator-note interpretation.
# /health works without any key so the Docker fallback image becomes ready.
GEMINI_API_KEY=
GROQ_API_KEY=

# Second key per vendor. A key from a different Google Cloud project, or a second
# Groq account, is a SEPARATE quota bucket, so it fails independently of the first
# even when it runs the same model. Both spellings are accepted (GEMINI_API_KEY_2
# or GEMINI_API_KEY2), because a silently unread key looks exactly like an
# exhausted quota at runtime.
GEMINI_API_KEY_2=
GROQ_API_KEY_2=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint, tried only when every provider above fails.
# Adding a second vendor with its own quota is the cheapest protection against a
# single key's rate limit taking the service down: without it, every provider in the
# chain shares one quota bucket and fails together.
EXTRA_NAME=
EXTRA_BASE_URL=
EXTRA_MODEL=
EXTRA_API_KEY=

# Optional tuning.
# BUDGET is the total wall-clock allowance for consensus; if the second opinion
# misses it, the request proceeds with whichever readings did arrive.
GRIDWISE_LLM_TIMEOUT=10
GRIDWISE_LLM_BUDGET=8.0
GRIDWISE_CONSENSUS_GRACE=2.0
GRIDWISE_CONSENSUS=2
GRIDWISE_LLM_CONCURRENCY=8
GRIDWISE_LLM_CHAIN=
GRIDWISE_GEMINI_MODEL=gemini-flash-lite-latest
GRIDWISE_GEMINI_MODEL_2=gemini-3.1-flash-lite
GRIDWISE_GROQ_MODEL=openai/gpt-oss-20b
GRIDWISE_OPENAI_MODEL=gpt-4o-mini
PORT=8000
GRIDWISE_LLM_DEADLINE=20
